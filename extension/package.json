{
  "name": "mailbot-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MailBot — disposable email with OTP, right in your browser.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:opera": "wxt build -b opera",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:opera": "wxt zip -b opera",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b opera",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build && npm run build:firefox"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "wxt": "^0.19.0"
  }
}
