{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gotemailbot",
  "main": "src/index.js",
  "account_id": "d36a36cd1d5b17048d3b20a4c32aa7c7",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Домены приёма. Первый не-.ru — дежурный (на нём pickDomain выдаёт новые адреса);
  // остальные продолжают принимать уже выданные адреса. Сейчас дежурный — ddress.site,
  // mailbot.click оставлен для приёма ранее выданных. Оба на Cloudflare Email Routing
  // (catch-all → этот воркер). emailbot.ru НЕ здесь: почта на Yandex; веб — 301 на ru.mailbot.click (GitHub Pages).
  "vars": {
    "DOMAINS": "ddress.site,mailbot.click",
    "PROMO_BASE": "https://301.st/",
    "CATCHALL_PROMO": "on",
    "CATCHALL_BASE": "https://catchall.in/",
    "BOX_TTL_HOURS": "24",
    "MAX_ACTIVE_BOXES": "2",
    "RL_PER_HOUR": "30",
    "NEW_PER_HOUR": "5",
    "NEW_PER_DAY": "20",
    "MAX_RAW_KB": "1024"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "gotemail", "database_id": "399e1409-02c7-45f8-a0bd-47da37b2ed56" }
  ],
  "kv_namespaces": [
    { "binding": "RL", "id": "99a6ced205984068809c8ac8e159e9ad" },
    { "binding": "PUSH_SUBS", "id": "5e7355bbff454734b160f10b2871dccb" }
  ],
  "triggers": { "crons": ["0 * * * *"] },

  "observability": { "enabled": true }
}
